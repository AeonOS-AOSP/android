<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="aeon"
          fetch="https://github.com/AeonOS-AOSP/"
          sync-c="true"
          sync-j="8"
          revision="refs/heads/lineage-23.0"
          review="review.lineageos.org" />

  <remote name="gitlab"
          fetch="https://gitlab.com/aeonaosp/"
          sync-c="true"
          sync-j="8"
          revision="refs/heads/lineage-23.0" />


  <!-- Android Manifest  -->
  <project path="android" name="android" remote="aeon" />

  <!-- Build  -->
  <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="aeon" >
    <linkfile dest="build/CleanSpec.mk" src="CleanSpec.mk" />
    <linkfile dest="build/buildspec.mk.default" src="buildspec.mk.default" />
    <linkfile dest="build/core" src="core" />
    <linkfile dest="build/envsetup.sh" src="envsetup.sh" />
    <linkfile dest="build/target" src="target" />
    <linkfile dest="build/tools" src="tools" />
  </project>
  <project path="build/soong" name="android_build_soong" groups="pdk,tradefed,sysui-studio" remote="aeon" >
    <linkfile dest="Android.bp" src="root.bp" />
    <linkfile dest="bootstrap.bash" src="bootstrap.bash" />
  </project>

  <!-- Frameworks  -->
  <project path="frameworks/av" name="android_frameworks_av" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="aeon" />
  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="aeon" />

  <!-- Lineage SDK  -->
  <project path="lineage-sdk" name="android_lineage-sdk" remote="aeon" />

  <!-- Packages  -->
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="aeon" />

  <!-- Vendor  -->
  <project path="vendor/lineage" name="android_vendor_lineage" remote="aeon" />
  <project path="vendor/addons" name="android_vendor_addons" remote="aeon" />
  <project path="vendor/google/gms" name="vendor_google_gms" remote="gitlab" />
  <project path="vendor/google/pixel" name="vendor_google_pixel" remote="gitlab" />
  <project path="vendor/official_devices" name="official_devices" remote="aeon" revision="refs/heads/main" />
</manifest>
